XBG_DB=./data/bookmarks.db
XBG_ASSISTANT_DB=./data/assistant.db
XBG_API_PORT=4177
XBG_WEB_ORIGIN=http://127.0.0.1:5173

# Browser used by crawl:x and crawl:youtube.
#   chromium — Playwright's bundled browser with its own profile; sign in once in the window it opens.
#   chrome / edge — clone your signed-in Chrome or Edge profile (the real browser can stay open).
XBG_BROWSER=chromium
# Profile folder inside Chrome/Edge user data ("Default", "Profile 1", …; see chrome://version).
XBG_BROWSER_PROFILE=Default
# yt-dlp cookie source for transcripts, e.g. chrome:Default or firefox. Empty derives it from
# XBG_BROWSER (chrome/edge); `none` disables cookies.
XBG_COOKIES_BROWSER=
# YouTube playlists to crawl: comma-separated IDs, optionally ID=Name. WL is Watch Later.
XBG_YOUTUBE_PLAYLISTS=WL

# Persistent Playwright profiles used when XBG_BROWSER=chromium.
XBG_X_PROFILE=./profiles/x
XBG_YOUTUBE_PROFILE=./profiles/youtube

# Second-brain assistant chat: auto | xai | claude | codex | grok | none.
# auto uses the xAI API when XAI_API_KEY is set, else the first of the claude / codex / grok CLIs on PATH.
XBG_ASSISTANT_PROVIDER=auto
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Optional. Without this, the system still imports, searches, fetches metadata,
# classifies with local rules, and builds the graph.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
