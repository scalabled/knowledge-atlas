{
  "name": "x-bookmark-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "catalog": "tsx src/pipeline/cli.ts catalog",
    "crawl:x": "tsx src/pipeline/cli.ts crawl-x",
    "crawl:youtube": "tsx src/pipeline/cli.ts crawl-youtube",
    "youtube:transcripts": "tsx src/pipeline/cli.ts youtube-transcripts",
    "import:siftly": "tsx src/pipeline/cli.ts import-siftly",
    "import:favorites": "tsx src/pipeline/cli.ts import-favorites",
    "links": "tsx src/pipeline/cli.ts links",
    "media:describe": "tsx src/pipeline/cli.ts media-describe",
    "classify": "tsx src/pipeline/cli.ts classify",
    "enrich": "tsx src/pipeline/cli.ts enrich",
    "graph:build": "tsx src/pipeline/cli.ts build-graph",
    "embed:real": "tsx src/pipeline/cli.ts embed",
    "stats": "tsx src/pipeline/cli.ts stats",
    "assistant:index": "tsx src/assistant/cli.ts index",
    "assistant:distill": "tsx src/assistant/cli.ts distill",
    "assistant:status": "tsx src/assistant/cli.ts status",
    "assistant:query": "tsx src/assistant/cli.ts query",
    "assistant:chat": "tsx src/assistant/cli.ts chat",
    "check": "tsc --noEmit",
    "test:layout": "tsx --test src/web/layout/unified-layout.test.ts",
    "test:second-brain": "tsx --test src/server/second-brain.test.ts",
    "test:assistant": "tsx --test src/assistant/assistant.test.ts",
    "test": "tsx --test src/web/layout/unified-layout.test.ts src/server/second-brain.test.ts src/assistant/assistant.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "@vitejs/plugin-react": "^5.1.2",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "d3-delaunay": "^6.0.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "jsdom": "^27.3.0",
    "lucide-react": "^0.576.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "officeparser": "^5.1.1",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.4",
    "sigma": "^3.0.2",
    "tsx": "^4.21.0",
    "unpdf": "^1.6.2",
    "vite": "^7.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/d3-delaunay": "^6.0.4",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^27.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.27",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
